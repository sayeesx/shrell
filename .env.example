# VAHN Automotive - Environment Configuration Template
VITE_APP_NAME="VAHN Automotive"
VITE_APP_URL="http://localhost:5173"

# Cloudinary Configuration (Unsigned Preset — keep API secret outside client bundles)
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="shrell_ecommerce"

# Supabase Configuration (Modern Publishable API Key)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
# Legacy anon key fallback
VITE_SUPABASE_ANON_KEY=""

# Appwrite Cloud Configuration
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your_appwrite_project_id"
VITE_APPWRITE_DATABASE_ID="vahn_ecommerce"
VITE_APPWRITE_BUCKET_ID="product_assets"

# Payment Configuration (India)
VITE_STORE_UPI_ID=""
VITE_STORE_UPI_NAME=""
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Communication & Support
VITE_WHATSAPP_SUPPORT_NUMBER="919876543210"

# Commerce Business Rules (Values in Integer Paisa: 1 INR = 100 Paisa)
VITE_FREE_SHIPPING_THRESHOLD_PAISA=499900
VITE_STANDARD_SHIPPING_PAISA=25000
VITE_GST_RATE_PERCENT=18

# PostHog Product Analytics (Vite React SPA)
VITE_POSTHOG_PROJECT_TOKEN=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
VITE_POSTHOG_KEY=""

# Sanity Headless CMS Configuration
VITE_SANITY_PROJECT_ID="your_sanity_project_id"
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2024-01-01"
VITE_SANITY_API_TOKEN="your_sanity_write_api_token"
VITE_SANITY_STUDIO_URL="https://your_sanity_project_id.sanity.studio"

